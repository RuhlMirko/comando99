---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { roles, type Role } from "../../data/roles";

export function getStaticPaths() {
  return roles.map((role) => ({
    params: { slug: role.slug },
    props: { role },
  }));
}

const { role } = Astro.props as { role: Role };
---

<Layout
  title={`${role.name} | Comando 99`}
  description={role.description}
  image={role.image}
>
  <Navbar
    navLinks={{ roles: "Todos los roles" }}
    navBasePath="/roles"
    isNotFrontPage
  />

  <main>
    <!-- <a class="back-link" href="/roles#roles">Volver a los roles</a> -->
    <article>
      <p class="eyebrow">{role.branch}</p>
      <h1>{role.name}</h1>
      <div class="level">Nivel: {role.level}</div>
      {
        role.image && (
          <img class="role-image" src={role.image} alt={`Rol ${role.name}`} />
        )
      }
      {
        role.description && (
          <section class="role-detail">
            <h2>Descripcion</h2>
            <p>{role.description}</p>
          </section>
        )
      }
      {
        role.common_equipment?.filter(Boolean).length ? (
          <section class="role-detail">
            <h2>Equipamiento habitual</h2>
            <ul>
              {role.common_equipment.filter(Boolean).map((equipment) => (
                <li>{equipment}</li>
              ))}
            </ul>
          </section>
        ) : null
      }
      {
        role.next_levels?.filter(Boolean).length ? (
          <footer>
            <h2>Siguientes niveles</h2>
            <ul>
              {role.next_levels.map((nextLevel) => (
                <li>{nextLevel}</li>
              ))}
            </ul>
            <div class="form-template">
              <p>
                Solicitar capacitación en el canal correspondiente con el
                siguiente formulario:
              </p>
              <div class="form-box">
                <button
                  type="button"
                  class="copy-button"
                  data-copy-target="form-text"
                  data-tooltip="Copiar al portapapeles"
                  aria-label="Copiar formulario al portapapeles"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                </button>
                <span id="form-text">
                  Rango y nombre:
                  <br />
                  Disponibilidad horaria:
                  <br />
                  Rol de interes:
                </span>
              </div>
            </div>
          </footer>
        ) : null
      }
      <section class="role-screenshots">
        <h2>Rol en accion</h2>
      </section>
    </article>
  </main>
</Layout>

<style>
  .form-template {
    margin-top: 2rem;
    font-style: italic;
    color: rgba(180, 166, 164, 0.699);
  }
  .form-box {
    position: relative;
    margin-top: 1rem;
    font-family: "Stick No Bills", sans-serif;
    letter-spacing: 2px;
    border: 1px solid rgba(128, 128, 128, 0.226);
    padding: 1rem;
    padding-right: 3rem;
    border-radius: 15px;
    background: #121212;
  }

  .copy-button {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 1px solid rgba(255, 229, 229, 0.2);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(246, 246, 246, 0.8);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .copy-button:hover {
    color: #ff504b;
    border-color: rgba(255, 80, 75, 0.6);
    background: rgba(255, 80, 75, 0.1);
  }

  .copy-button.copied {
    color: #4caf50;
    border-color: rgba(76, 175, 80, 0.6);
  }

  .copy-button::after {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 1;
    width: max-content;
    max-width: min(14rem, 75vw);
    padding: 0.4rem 0.55rem;
    border: 1px solid rgba(255, 80, 75, 0.6);
    border-radius: 4px;
    background: rgba(255, 80, 75, 0.1);
    color: rgba(248, 173, 173, 0.9);
    content: attr(data-tooltip);
    font-family: "Rajdhani", sans-serif;
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.2rem);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .copy-button:hover::after,
  .copy-button:focus-visible::after {
    opacity: 1;
    transform: translateY(0);
  }

  :global(body) {
    background: linear-gradient(160deg, #050505 0%, #0d0808 46%, #030202 100%);
  }

  main {
    width: min(780px, 92vw);
    margin: 0 auto;
    padding: 9rem 0 4rem;
  }

  .back-link {
    color: rgba(255, 235, 235, 0.86);
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  .back-link:hover {
    color: #ff504b;
  }

  article {
    margin-top: 1.25rem;
    padding: clamp(1.4rem, 4vw, 2.5rem);
    border: 1px solid rgba(255, 120, 120, 0.28);
    border-left: 5px solid #d12b2f;
    background: linear-gradient(
      170deg,
      rgba(14, 14, 14, 0.94),
      rgba(5, 5, 5, 0.96)
    );
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.35);
  }

  .eyebrow {
    margin: 0;
    color: #ff817e;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.35rem 0 1rem;
    font-family: "Stick No Bills", sans-serif;
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    letter-spacing: 1px;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .level {
    display: inline-block;
    margin-bottom: 1.5rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid rgba(255, 229, 229, 0.23);
    background: rgba(166, 20, 20, 0.25);
    font-weight: 700;
    text-transform: uppercase;
  }

  article p:not(.eyebrow) {
    max-width: 62ch;
    margin: 0.8rem 0;
    color: rgba(246, 246, 246, 0.9);
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .role-image {
    display: block;
    width: 100%;
    max-height: 360px;
    margin: 0.25rem 0 1.5rem;
    border: 1px solid rgba(255, 229, 229, 0.2);
    object-fit: cover;
  }

  .role-detail {
    margin-top: 1.5rem;
  }

  .role-detail h2 {
    margin: 0 0 0.65rem;
    color: #db2c29;
    font-family: "Stick No Bills", sans-serif;
    font-size: 1.7rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .role-detail ul {
    display: flex;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
  }

  .role-detail li {
    padding: 0.5rem 0.65rem;
    border: 1px solid rgba(255, 229, 229, 0.16);
    background: rgba(165, 163, 163, 0.16);
    font-weight: 600;
  }

  .role-detail p {
    white-space: pre-line;
  }

  footer {
    margin-block: 1.75rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 120, 120, 0.28);
  }

  footer h2,
  .role-screenshots h2 {
    margin: 0 0 0.65rem;
    color: #ff817e;
    font-family: "Stick No Bills", sans-serif;
    font-size: 1.7rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  footer ul {
    display: flex;
    justify-content: space-around;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  footer li {
    width: 100%;
    text-align: center;
    padding: 0.5rem 0.65rem;
    border: 1px solid rgba(255, 229, 229, 0.16);
    background: rgba(166, 20, 20, 0.16);
    font-weight: 600;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".copy-button")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const targetId = button.dataset.copyTarget;
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;

        try {
          await navigator.clipboard.writeText(target.innerText.trim());
          button.classList.add("copied");
          setTimeout(() => button.classList.remove("copied"), 1500);
        } catch {
          // Clipboard API unavailable or denied; nothing to fall back to here.
        }
      });
    });
</script>
