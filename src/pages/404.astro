---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Comando 99 | Pagina no encontrada">
  <Navbar navLinks={{}} isNotFrontPage />

  <main>
    <section class="not-found">
      <p class="error-code">404</p>
      <div class="text-container">
        <h1>Pagina no encontrada</h1>
        <p class="intro">
          La pagina que buscas no existe o fue movida de lugar.
        </p>
        <div class="links">
          <a href="/" class="cta-link">Volver al Inicio</a>
          <a href="/galeriaCompleta" class="cta-link secondary">Ver Galeria</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* background: #35040270; */
    background: linear-gradient(#201c1b70 10%, #35040270 50%, #201c1b70 98%);
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.027) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.027) 1px, transparent 1px);
      background-size: 24px 24px;
    }
  }

  .not-found {
    text-align: center;
    padding: 2rem;
  }

  .error-code {
    font-family: "Stick No Bills", "Chakra Petch", sans-serif;
    letter-spacing: 12px;
    font-size: clamp(5rem, 15vw, 10rem);
    line-height: 1;
    margin: 0;
    color: #c7191e;
    text-shadow: 0 0 25px rgba(199, 25, 30, 0.6);
  }

  .text-container {
    background: #121212;
    padding: 1rem 2rem 2rem;
    border: 1px solid gray;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 600;
    margin: 0.5rem 0 1rem;
    text-transform: uppercase;
    letter-spacing: 3px;
  }

  .intro {
    color: rgb(204, 184, 184);
    font-size: 1.1rem;
    max-width: 40ch;
    margin: 0 auto 2rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-link {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
    background: #c7191e;
    color: white;
    transition: 0.2s;
  }

  .cta-link:hover {
    background: #a00a05;
    transform: translateY(-3px);
  }

  .cta-link.secondary {
    background: transparent;
    color: white;
    border: 1px solid gray;
  }

  .cta-link.secondary:hover {
    background: rgba(199, 25, 30, 0.15);
  }
</style>
